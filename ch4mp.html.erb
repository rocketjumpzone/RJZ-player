      <div style="position: relative; display: inline-block;">
        <div style="border: 4px solid var(--main-red); border-radius: 50%; padding: 5px; background: #000;">
          <%= partial "partials/player/ch4mp/avatar" %>
        </div>
      </div>

      <h1 class="blazing w3-xxxlarge" style="margin-top: 15px; font-weight: 900; letter-spacing: 3px;"><%= data.players.ch4mp.name %></h1>

      <%# Reputation Badges %>
      <div style="display: flex; justify-content: center; gap: 15px; margin-top: 10px;">
        <div class="w3-tooltip">
          <i class="fa-solid fa-crown w3-xlarge" style="color:#CD05E7; filter: drop-shadow(0 0 5px #CD05E7);"></i>
          <span class="w3-text w3-tag w3-black w3-small w3-round" style="position:absolute; bottom:35px; left:-40px; width:120px;">DRAMA QUEEN</span>
        </div>
        <div class="w3-tooltip">
          <i class="fa-solid fa-biohazard w3-xlarge" style="color:#5ED729; filter: drop-shadow(0 0 5px #5ED729);"></i>
          <span class="w3-text w3-tag w3-black w3-small w3-round" style="position:absolute; bottom:35px; left:-40px; width:120px;">TOXIC</span>
        </div>
      </div>
    </div>

    <div class="w3-col l9 m8">
      <div class="w3-container">
        <h4 style="color: var(--main-red); font-weight: 900; text-transform: uppercase; letter-spacing: 2px;">Biography</h4>
        <p class="w3-xlarge" style="font-style: italic; opacity: 0.9; line-height: 1.4;">
          Competitive player since 2015. Xonotic beast.<br> LawBreakers pro player <i class="far fa-grin-tears" style="font-size: 0.8em;"></i>
        </p>

        <div class="w3-row-padding w3-margin-top" style="background: rgba(255,255,255,0.03); padding: 20px; border-radius: var(--radius-md); border-left: 4px solid var(--main-red);">
          <div class="w3-third">
            <span class="w3-tiny" style="opacity: 0.6; text-transform: uppercase;">Nationality</span><br>
            <img src="../../images/flags/4x3/<%= current_page.data.country_tag %>.svg" width="20" height="20" alt="<%= current_page.data.country_name %>">
            <b class="w3-large">&nbsp;<%= current_page.data.country_name %></b>
          </div>
          <div class="w3-third">
            <span class="w3-tiny" style="opacity: 0.6; text-transform: uppercase;">Organization</span><br>
            <b class="w3-large">-</b>
          </div>
          <div class="w3-third w3-right-align">
            <div class="player-social w3-xlarge" style="display: flex; justify-content: flex-end; gap: 20px;">
              <a href="https://www.youtube.com/@hellchallenge_peter" target="_blank" class="w3-hover-text-red"><i class="fab fa-youtube"></i></a>
              <a href="https://steamcommunity.com/id/hellchallenge_peter" target="_blank" class="w3-hover-text-red"><i class="fab fa-steam"></i></a>
              <a href="https://instagram.com/hellchallenge_peter" target="_blank" class="w3-hover-text-red"><i class="fab fa-instagram"></i></a>
              <div class="w3-tooltip">
                <i class="fab fa-discord"></i>
                <span style="position:absolute;right:0;bottom:35px;width:180px" class="w3-text w3-tag w3-black w3-small w3-round"><%= current_page.data.discord_id %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
