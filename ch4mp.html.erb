    <div class="w3-row" style="max-width: 900px; margin: 0 auto;">
      <div class="w3-third">
        <i class="fas fa-trophy w3-xlarge trophy-gold"></i>
        <span class="w3-xxlarge" style="font-weight: 900; margin-left: 10px;"><%= data.players.ch4mp.trophies.gold %></span>
        <div class="w3-tiny opacity-6" style="letter-spacing: 2px;">GOLD TROPHIES</div>
      </div>
      <div class="w3-third">
