---
layout: player
title: "Jerki | Pro Player Profile"
name: "jerki"
org: "-"
discord_id: "jerkipoo"
country_tag: "ca"
country_name: "Canada, Winnipeg"
---

<div class="w3-auto w3-container w3-animate-opacity" style="padding-bottom: 100px;">

  <%# --- 1. HERO IDENTITY SECTION --- %>
  <div class="w3-row-padding w3-padding-64" style="background: linear-gradient(180deg, #1a1a1e 0%, #0e0e10 100%); border-bottom: 2px solid var(--main-red); margin-top: 20px; border-radius: var(--radius-md) var(--radius-md) 0 0;">

    <div class="w3-col l3 m4 w3-center">
      <div style="position: relative; display: inline-block;">
        <div style="border: 4px solid var(--main-red); border-radius: 50%; padding: 5px; background: #000;">
          <%= partial "partials/player/jerki/avatar" %>
        </div>
      </div>
      <h1 class="blazing w3-xxxlarge" style="margin-top: 15px; font-weight: 900; letter-spacing: 3px;"><%= current_page.data.name %></h1>
    </div>

    <div class="w3-col l9 m8">
      <div class="w3-container">
        <h4 style="color: var(--main-red); font-weight: 900; text-transform: uppercase; letter-spacing: 2px;">Biography</h4>
        <p class="w3-xlarge" style="font-style: italic; opacity: 0.9; line-height: 1.4;">
          stupid idiot from egg game and reflex.
        </p>

        <div class="w3-row-padding w3-margin-top" style="background: rgba(255,255,255,0.03); padding: 20px; border-radius: var(--radius-md); border-left: 4px solid var(--main-red);">
          <div class="w3-third">
            <span class="w3-tiny" style="opacity: 0.6; text-transform: uppercase;">Nationality</span><br>
            <img src="../../images/flags/4x3/<%= current_page.data.country_tag %>.svg" width="20" height="20" alt="<%= current_page.data.country_name %>">
            <b class="w3-large">&nbsp;<%= current_page.data.country_name %></b>
          </div>
          <div class="w3-third">
            <span class="w3-tiny" style="opacity: 0.6; text-transform: uppercase;">Organization</span><br>
            <b class="w3-large"><%= current_page.data.org %></b>
          </div>
          <div class="w3-third w3-right-align">
            <div class="player-social w3-xlarge" style="display: flex; justify-content: flex-end; gap: 20px;">
              <a href="https://www.youtube.com/@WindowBreakingGaming" target="_blank" class="w3-hover-text-red"><i class="fab fa-youtube"></i></a>
              <a href="https://steamcommunity.com/id/nipplezits/" target="_blank" class="w3-hover-text-red"><i class="fab fa-steam"></i></a>
              <a href="https://www.twitch.tv/jerkidbt" target="_blank" class="w3-hover-text-red"><i class="fab fa-twitch"></i></a>
              <div class="w3-tooltip">
                <i class="fab fa-discord"></i>
                <span style="position:absolute;right:0;bottom:35px;width:180px" class="w3-text w3-tag w3-black w3-small w3-round"><%= current_page.data.discord_id %></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# --- 2. TROPHY BAR --- %>
  <div class="w3-container w3-padding-24 w3-center" style="background: var(--main-darker); border: 1px solid var(--border-soft); border-top: 0; border-radius: 0 0 var(--radius-md) var(--radius-md); margin-bottom: 40px;">
    <div class="w3-row" style="max-width: 900px; margin: 0 auto;">
      <div class="w3-third">
        <i class="fas fa-trophy w3-xlarge trophy-gold"></i>
        <span class="w3-xxlarge" style="font-weight: 900; margin-left: 10px;"><%= data.players.jerki.trophies.gold %></span>
        <div class="w3-tiny opacity-6" style="letter-spacing: 2px;">GOLD TROPHIES</div>
      </div>
      <div class="w3-third">
        <i class="fas fa-trophy w3-xlarge trophy-silver"></i>
        <span class="w3-xxlarge" style="font-weight: 900; margin-left: 10px;"><%= data.players.jerki.trophies.silver %></span>
        <div class="w3-tiny opacity-6" style="letter-spacing: 2px;">SILVER TROPHIES</div>
      </div>
      <div class="w3-third">
        <i class="fas fa-trophy w3-xlarge trophy-bronze"></i>
        <span class="w3-xxlarge" style="font-weight: 900; margin-left: 10px;"><%= data.players.jerki.trophies.bronze %></span>
        <div class="w3-tiny opacity-6" style="letter-spacing: 2px;">BRONZE TROPHIES</div>
      </div>
    </div>
  </div>

  <%# --- 3. CAREER HISTORY --- %>
  <div class="w3-row-padding">
    <div class="w3-col l12 m12">
      <h2 style="font-weight: 900; text-transform: uppercase; border-left: 6px solid var(--main-red); padding-left: 20px; margin-bottom: 30px;">Career History</h2>
      <div class="w3-card" style="background: var(--main-darker); border: 1px solid var(--border-soft); border-radius: var(--radius-md); overflow: hidden;">
        <table class="w3-table w3-bordered tourneys">
          <thead style="background: #1a1a1e;">
            <tr>
              <th style="font-size: 16px;">Event</th>
              <th class="w3-center" style="font-size: 16px;">Earned</th>
              <th class="w3-center" style="font-size: 16px;">Place</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><a href="/reflex-arena/rjz-reflex-arena-duel-cup/" target="_blank" class="link-red">RJZ Reflex Arena Duel Cup 2025</a></td>
              <td class="w3-center">-</td>
              <td class="w3-center"><i class="fas fa-trophy trophy-silver"></i></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="sharethis-inline-reaction-buttons" style="margin-top:80px"></div>
</div>
